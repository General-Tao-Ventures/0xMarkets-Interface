# Partner contact API — api/partner/*
#
# Copy to .env.partner for local work, or set the same names as Vercel project env vars.
# Nothing here is read by the browser bundle: these are server-side only.

# Postgres holding partner contact details. Cloud SQL in production.
# Local Docker:  postgres://partner:partner@localhost:5442/partner?sslmode=disable
PARTNER_DATABASE_URL=

# HMAC key for session tokens. At least 32 characters. Rotating it signs everyone out.
#   openssl rand -hex 32
PARTNER_SESSION_SECRET=

# Addresses allowed to read partner contact details via /api/partner/admin-contacts.
# Comma-separated. UNSET DENIES EVERYONE — this is the real gate, not the browser one.
PARTNER_ADMIN_ADDRESSES=

# --- optional: channel delivery ---------------------------------------------
# Without these, email verification returns 503 rather than pretending to send.
PARTNER_RESEND_API_KEY=
PARTNER_EMAIL_FROM=

# Telegram bot the partner sends their token to. Display only.
PARTNER_TELEGRAM_BOT=@0xMarketsBot

# LOCAL DEVELOPMENT ONLY. Returns the verification code to the browser so the flow can be
# completed without a mail provider. Must never be set on a deployed environment.
PARTNER_DEV_ECHO_CODE=

# Where `vite dev` proxies /api/partner. Defaults to the local dev server.
PARTNER_API_URL=http://127.0.0.1:3020
