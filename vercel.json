{
  "functions": {
    "api/keeper/[...path].ts": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/order-keeper/[...path].ts": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/upload.ts": {
      "memory": 256,
      "maxDuration": 15,
      "includeFiles": "node_modules/@vercel/blob/**"
    },
    "api/s.ts": {
      "memory": 128,
      "maxDuration": 5,
      "includeFiles": "node_modules/@vercel/blob/**"
    }
  }
}
