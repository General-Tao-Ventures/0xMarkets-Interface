{
  "rewrites": [
    { "source": "/api/keeper/:path*", "destination": "/api/keeper-proxy?_path=:path*" },
    { "source": "/api/order-keeper/:path*", "destination": "/api/order-keeper-proxy?_path=:path*" },
    { "source": "/api/squid/:path*", "destination": "/api/squid-proxy?_path=:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self';" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ],
  "functions": {
    "api/keeper-proxy.ts": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/order-keeper-proxy.ts": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/squid-proxy.ts": {
      "memory": 128,
      "maxDuration": 15
    },
    "api/upload.ts": {
      "memory": 256,
      "maxDuration": 15,
      "includeFiles": "node_modules/@vercel/blob/**"
    },
    "api/s.ts": {
      "memory": 128,
      "maxDuration": 5,
      "includeFiles": "node_modules/@vercel/blob/**"
    }
  }
}
